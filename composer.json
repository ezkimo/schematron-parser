{
    "name": "mmnewmedia/schematron-parser",
    "description": "XPath expression parser and compiler for Schematron rule files",
    "keywords": ["schematron", "xpath", "parser", "compiler", "xml", "validation", "en16931"],
    "type": "library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Marcel Maaß",
            "email": "info@mm-newmedia.de"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "ext-dom": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "vimeo/psalm": "^6.5"
    },
    "autoload": {
        "psr-4": {
            "MMNewmedia\\Schematron\\": "src/Schematron/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MMNewmedia\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/compile-schematron-rules.php"
    ],
    "scripts": {
        "test": "phpunit",
        "psalm": "psalm"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
